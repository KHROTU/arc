{
  "name": "arc-workspace",
  "private": true,
  "version": "0.0.2-alpha.2",
  "description": "Arc — agentic coding VS Code extension (monorepo root).",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:ext": "pnpm --filter @arc/host build && pnpm --filter arc build",
    "build:webview": "pnpm --filter @arc/webview build",
    "watch": "pnpm -r --parallel build --watch",
    "test": "pnpm -r test",
    "package": "pnpm --filter arc package",
    "clean": "pnpm -r exec rm -rf dist out *.vsix"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/vscode": "1.95.0",
    "@vitest/coverage-v8": "2.0.5",
    "esbuild": "0.23.0",
    "glob": "^13.0.6",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}

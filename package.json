{
  "name": "arc-workspace",
  "private": true,
  "version": "0.5.4",
  "description": "Arc — agentic coding VS Code extension (monorepo root).",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:ext": "pnpm --filter @arc/host build && pnpm --filter arc-code build",
    "build:webview": "pnpm --filter @arc/webview build",
    "watch": "pnpm -r --parallel build --watch",
    "test": "pnpm -r test",
    "package": "pnpm --filter arc-code package",
    "clean": "pnpm -r exec rm -rf dist out *.vsix"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "22.18.0",
    "@types/vscode": "1.95.0",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "glob": "^13.0.6",
    "playwright": "1.62.0",
    "sharp": "^0.35.3",
    "typescript": "5.5.4",
    "vite": "8.0.16",
    "vitest": "4.1.10"
  }
}

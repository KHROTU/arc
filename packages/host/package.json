{
  "name": "@arc/host",
  "version": "0.5.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js",
      "require": "./dist/protocol/index.cjs"
    },
    "./catalog": {
      "types": "./dist/providers/catalog.d.ts",
      "import": "./dist/providers/catalog.js",
      "require": "./dist/providers/catalog.cjs"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "vscode-uri": "3.0.8",
    "diff": "5.2.2"
  },
  "devDependencies": {
    "typescript": "5.5.4",
    "@types/node": "20.14.10",
    "@types/diff": "5.2.2",
    "vitest": "2.0.5"
  },
  "optionalDependencies": {
    "playwright": "1.55.1"
  },
  "peerDependencies": {
    "playwright": "1.55.1"
  }
}

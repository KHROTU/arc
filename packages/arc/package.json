{
  "name": "arc-code",
  "displayName": "Arc",
  "description": "0.20 MB agentic coding assistant. 150+ providers with tiered model routing, failover, and multi-model subagents.",
  "version": "0.5.1",
  "publisher": "khrotu",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/khrotu/arc"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=18.18.0"
  },
  "main": "dist/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Snippets",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "agent",
    "coding",
    "autonomous",
    "pair programming",
    "code assistant",
    "ai agent",
    "ai coding agent",
    "copilot",
    "mcp",
    "playwright",
    "claude",
    "openai",
    "anthropic",
    "gpt",
    "model router",
    "multi-model",
    "subagent",
    "handoff",
    "arc",
    "open source"
  ],
  "icon": "assets/arc-logo-mono.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.css",
    "assets/arc-logo-mono.png",
    "assets/arc-logo-mono.svg",
    "assets/arc-logo-pride.svg",
    "assets/arc-logo-mono-text.svg",
    "LICENSE*",
    "package.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arc-activitybar",
          "title": "Arc",
          "icon": "assets/arc-logo-mono.svg",
          "when": "!arc.isPrideMonth"
        },
        {
          "id": "arc-activitybar-pride",
          "title": "Arc",
          "icon": "assets/arc-logo-pride.svg",
          "when": "arc.isPrideMonth"
        }
      ]
    },
    "views": {
      "arc-activitybar": [
        {
          "type": "webview",
          "id": "arc-sidebar",
          "name": "Arc",
          "icon": "assets/arc-logo-mono.svg",
          "contextualTitle": "Arc",
          "when": "!arc.isPrideMonth"
        }
      ],
      "arc-activitybar-pride": [
        {
          "type": "webview",
          "id": "arc-sidebar-pride",
          "name": "Arc",
          "icon": "assets/arc-logo-pride.svg",
          "contextualTitle": "Arc",
          "when": "arc.isPrideMonth"
        }
      ]
    },
    "commands": [
      {
        "command": "arc.openSidebar",
        "title": "Open Sidebar Chat",
        "category": "Arc"
      },
      {
        "command": "arc.openFullscreen",
        "title": "Open Full-Screen Chat",
        "category": "Arc"
      },
      {
        "command": "arc.openSettings",
        "title": "Open Settings",
        "category": "Arc"
      },
      {
        "command": "arc.newTask",
        "title": "New Task",
        "category": "Arc"
      },
      {
        "command": "arc.stop",
        "title": "Stop Current Task",
        "category": "Arc"
      },
      {
        "command": "arc.continue",
        "title": "Continue Last Task",
        "category": "Arc"
      },
      {
        "command": "arc.toggleProblems",
        "title": "Toggle Problems Panel",
        "category": "Arc"
      },
      {
        "command": "arc.manageModels",
        "title": "Manage Models",
        "category": "Arc"
      },
      {
        "command": "arc.manageMcp",
        "title": "Manage MCP Servers",
        "category": "Arc"
      },
      {
        "command": "arc.managePrompts",
        "title": "Manage System Prompts",
        "category": "Arc"
      },
      {
        "command": "arc.auditLog.export",
        "title": "Export Audit Log",
        "category": "Arc"
      },
      {
        "command": "arc.auditLog.verify",
        "title": "Verify Audit Log",
        "category": "Arc"
      },
      {
        "command": "arc.openPlayground",
        "title": "Open Component Playground",
        "category": "Arc"
      },
      {
        "command": "arc.explainSelection",
        "title": "Explain with Arc",
        "category": "Arc"
      },
      {
        "command": "arc.fixSelection",
        "title": "Fix with Arc",
        "category": "Arc"
      },
      {
        "command": "arc.inlineChat",
        "title": "Inline Chat",
        "category": "Arc"
      },
      {
        "command": "arc.inlineChat.submit",
        "title": "Send to Arc",
        "category": "Arc",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "arc.inlineChat.cancel",
        "title": "Discard",
        "category": "Arc",
        "icon": "$(trash)"
      },
      {
        "command": "arc.inlineChat.pickModel",
        "title": "Switch Model",
        "category": "Arc",
        "icon": "$(arrow-swap)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "arc.openSidebar",
          "when": "true"
        },
        {
          "command": "arc.openFullscreen",
          "when": "true"
        },
        {
          "command": "arc.openSettings",
          "when": "true"
        },
        {
          "command": "arc.openPlayground",
          "when": "true"
        },
        {
          "command": "arc.newTask",
          "when": "true"
        },
        {
          "command": "arc.stop",
          "when": "true"
        },
        {
          "command": "arc.continue",
          "when": "true"
        },
        {
          "command": "arc.toggleProblems",
          "when": "true"
        },
        {
          "command": "arc.manageModels",
          "when": "true"
        },
        {
          "command": "arc.manageMcp",
          "when": "true"
        },
        {
          "command": "arc.managePrompts",
          "when": "true"
        },
        {
          "command": "arc.auditLog.export",
          "when": "true"
        },
        {
          "command": "arc.auditLog.verify",
          "when": "true"
        },
        {
          "command": "arc.explainSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "arc.fixSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "arc.inlineChat",
          "when": "editorTextFocus"
        }
      ],
      "editor/context": [
        {
          "command": "arc.explainSelection",
          "when": "editorHasSelection",
          "group": "arc@1"
        },
        {
          "command": "arc.fixSelection",
          "when": "editorHasSelection",
          "group": "arc@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "arc.inlineChat.submit",
          "group": "inline",
          "when": "commentController == arc.inlineChat"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "arc.inlineChat.cancel",
          "group": "navigation",
          "when": "commentController == arc.inlineChat"
        }
      ],
      "comments/comment/title": [
        {
          "command": "arc.inlineChat.pickModel",
          "group": "navigation",
          "when": "commentController == arc.inlineChat && comment == arcModelHeader"
        }
      ]
    },
    "keybindings": [
      {
        "command": "arc.openSidebar",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "arc.openFullscreen",
        "key": "ctrl+shift+alt+a",
        "mac": "cmd+shift+alt+a"
      },
      {
        "command": "arc.openSettings",
        "key": "ctrl+shift+,",
        "mac": "cmd+shift+,"
      },
      {
        "command": "arc.newTask",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n"
      },
      {
        "command": "arc.inlineChat",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Arc",
      "properties": {
        "arc.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show native OS notifications when a task completes, handoff occurs, or input is needed."
        },
        "arc.shell.approval": {
          "type": "string",
          "enum": [
            "always",
            "allowlist",
            "off"
          ],
          "default": "allowlist",
          "description": "Shell command approval policy."
        },
        "arc.shell.allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "ls",
            "dir",
            "cat",
            "type",
            "cp",
            "copy",
            "mv",
            "move",
            "rm",
            "del",
            "mkdir",
            "rmdir",
            "grep",
            "rg",
            "find",
            "findstr",
            "sed",
            "awk",
            "diff",
            "git",
            "gh",
            "pnpm",
            "npm",
            "yarn",
            "npx",
            "node",
            "python",
            "pip",
            "go",
            "cargo",
            "rustc",
            "make",
            "gcc",
            "g++",
            "curl",
            "wget",
            "tar",
            "zip",
            "unzip",
            "ssh",
            "docker",
            "kubectl",
            "tsc",
            "eslint",
            "prettier",
            "jest",
            "vitest",
            "esbuild",
            "vite",
            "pwsh",
            "powershell",
            "Get-ChildItem",
            "Get-Content",
            "Set-Content",
            "New-Item",
            "Remove-Item",
            "Copy-Item",
            "Move-Item",
            "Test-Path",
            "Select-String",
            "Invoke-WebRequest",
            "echo",
            "cd",
            "tasklist",
            "taskkill",
            "netstat",
            "ping",
            "ipconfig",
            "whoami"
          ],
          "description": "Commands that can run without explicit approval when shell.approval is 'allowlist'."
        },
        "arc.compaction.strategy": {
          "type": "string",
          "enum": [
            "model-aware",
            "fixed"
          ],
          "default": "model-aware",
          "description": "Context compaction strategy. 'model-aware' uses the model's observed average thinking+response length."
        },
        "arc.compaction.safetyMargin": {
          "type": "number",
          "default": 0.15,
          "description": "Safety margin reserved for model output (fraction of window)."
        },
        "arc.verify.mode": {
          "type": "string",
          "enum": [
            "none",
            "default",
            "custom"
          ],
          "enumDescriptions": [
            "Never run post-edit verification commands, even if .arc/verify.toml defines them.",
            "Use the retry count defined in .arc/verify.toml (falls back to 3 if unset).",
            "Override the retry count with arc.verify.customMaxRetries."
          ],
          "default": "default",
          "description": "Controls how post-edit verification (running configured verify commands after file edits) retries on failure."
        },
        "arc.verify.customMaxRetries": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "Number of retry attempts for post-edit verification when arc.verify.mode is 'custom'."
        },
        "arc.search.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable semantic code search. Requires Ollama running locally for the semantic backend."
        },
        "arc.search.backend": {
          "type": "string",
          "enum": [
            "hash-based",
            "semantic"
          ],
          "default": "hash-based",
          "description": "Embedding backend. 'hash-based' works offline with no model. 'semantic' uses Ollama with a local model."
        },
        "arc.search.modelTier": {
          "type": "string",
          "enum": [
            "low",
            "mid",
            "high"
          ],
          "default": "low",
          "description": "Embedding model quality tier. low = nomic-embed-text:v1.5, mid = qwen3-embedding:0.6b, high = qwen3-embedding:8b."
        },
        "arc.search.ollamaUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Ollama base URL for the semantic embedding backend."
        },
        "arc.indexing.autoWatch": {
          "type": "boolean",
          "default": true,
          "description": "Automatically keep the semantic search index up to date using a filesystem watcher (with a polling fallback) after the initial index build. Disable to opt out (equivalent to --no-watch)."
        },
        "arc.search.autoReindex": {
          "type": "string",
          "enum": [
            "off",
            "hourly",
            "daily"
          ],
          "default": "off",
          "description": "Periodically trigger a full workspace reindex on a schedule, in addition to the live IndexWatcher. 'off' disables scheduled reindexing."
        },
        "arc.titleGeneration.method": {
          "type": "string",
          "enum": [
            "first-words",
            "ollama"
          ],
          "default": "first-words",
          "description": "Method for generating chat titles. 'first-words' uses the first 40 chars of the first message. 'ollama' uses the titlegemma model via Ollama."
        },
        "arc.model.multimodalIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of model IDs that support multimodal (vision) input."
        },
        "arc.image.describeModel": {
          "type": "string",
          "enum": [
            "none",
            "minicpm-v:1b",
            "ministral-3:8b-cloud",
            "gemma4:31b-cloud"
          ],
          "default": "none",
          "description": "Model to describe attached images when the active model isn't multimodal. Uses local Ollama or Ollama Cloud."
        },
        "arc.proxy.url": {
          "type": "string",
          "default": "",
          "description": "Fallback proxy URL used when a category-specific proxy is not set. Applies to provider API calls, web tools, and shell commands. Example: http://proxy.company.com:8080."
        },
        "arc.proxy.providerUrl": {
          "type": "string",
          "default": "",
          "description": "Proxy URL for model provider API calls (OpenAI, Anthropic, Ollama, etc.). Falls back to arc.proxy.url if empty."
        },
        "arc.proxy.webUrl": {
          "type": "string",
          "default": "",
          "description": "Proxy URL for web.fetch and web.search tools. Falls back to arc.proxy.url if empty."
        },
        "arc.proxy.shellUrl": {
          "type": "string",
          "default": "",
          "description": "Proxy URL for shell commands. Sets HTTP_PROXY/HTTPS_PROXY environment variables on spawned child processes. Falls back to arc.proxy.url if empty."
        },
        "arc.appearance.prideLogo": {
          "type": "string",
          "enum": [
            "always",
            "june",
            "never"
          ],
          "default": "june",
          "description": "When to show the pride logo in the welcome text and sidebar icon."
        },
        "arc.appearance.toolTree": {
          "type": "string",
          "enum": [
            "auto",
            "collapsed"
          ],
          "default": "auto",
          "description": "How tool call trees display. 'auto' expands the tree and last call (closes earlier calls) and closes when the chain ends. 'collapsed' keeps all trees collapsed."
        },
        "arc.discord.spoofRpc": {
          "type": "boolean",
          "default": false,
          "description": "Show the file the agent is actively editing as your Discord presence (spoofs file activity so Discord RPC extensions report agent edits as your status)."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "arc.welcome",
        "title": "Arc",
        "description": "Get Arc set up: add a model, pick a tier, run your first task.",
        "steps": [
          {
            "id": "arc.welcome.open",
            "title": "Open Arc",
            "description": "Click the Arc icon in the activity bar.",
            "command": "arc.openSidebar"
          },
          {
            "id": "arc.welcome.model",
            "title": "Add a model",
            "description": "Open Arc settings to add at least one model and provider.",
            "command": "arc.manageModels"
          },
          {
            "id": "arc.welcome.run",
            "title": "Run a task",
            "description": "Ask Arc to do something in the chat."
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "vsce package --no-dependencies",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/vscode": "1.95.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.23.0",
    "@vscode/vsce": "2.32.0",
    "vitest": "2.0.5"
  },
  "dependencies": {
    "@arc/host": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
